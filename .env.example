# Copy to .env and fill in. NEVER commit .env.

# Which AI to use: anthropic | openai | ollama | fake
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1   # change it to use Groq, LM Studio, OpenRouter...

# Inside a container, "localhost" is the container itself. Pick the one that matches where Ollama runs:
#   Ollama installed on your machine, API in Docker -> http://host.docker.internal:11434
#   Ollama via `docker compose --profile ollama`     -> http://ollama:11434
#   Everything on your machine, no Docker            -> http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Seconds to wait for an answer (CPU is slow) and how long the model stays loaded
# OLLAMA_TIMEOUT=300
# OLLAMA_KEEP_ALIVE=30m

PROFILE_PATH=config/profile.yml
