# Copy to .env and fill in. NEVER commit .env.

# Which AI to use: anthropic | openai | ollama | fake
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1   # change it to use Groq, LM Studio, OpenRouter...

# With Docker Compose use http://ollama:11434 — inside a container, "localhost" is the container itself.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

PROFILE_PATH=config/profile.yml
